// KH Esports Advertisement System
// Add this rule to your existing Firebase Storage rules.
// Tighten the authenticated condition if your project has non-admin users.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /advertisements/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
