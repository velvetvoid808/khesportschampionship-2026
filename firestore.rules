rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /brackets/{game} {
      allow read: if game == "hok" || game == "mlbb";
      allow write: if request.auth != null;
    }

    match /siteContent/advertisement {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
